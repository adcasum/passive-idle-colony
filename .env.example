# Solana RPC. For production, sign up for Helius free tier and replace.
# https://www.helius.dev/
EXPO_PUBLIC_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_CLUSTER=devnet

# Optional: Bubblegum Merkle tree address used for cNFT mints.
# If unset, the mint screen will show a placeholder until you create a tree.
EXPO_PUBLIC_BUBBLEGUM_TREE=
EXPO_PUBLIC_BUBBLEGUM_COLLECTION=

# Supabase (cloud-save, analytics, leaderboard).
# If unset, the app falls back to local-only mode (no cloud features).
# Anon key is safe to ship to clients; RLS restricts writes by x-wallet-address header.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
